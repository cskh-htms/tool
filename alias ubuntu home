#
# chay reload source
alias llas='source ~/.bashrc && echo "da reload alias"'
alias llan='nano  ~/.bash_aliases'


#
# alias view ---------------------------------------------------
llah() {
    alias | grep -F -- "$*"
}




#
#  llac htms_web
# Xoa alias cu trung ten truoc khi khai bao cac ham.
# unalias llac llag lla 2>/dev/null || true

llac() {
  local repo="${1:?Cách dùng: llac ten-repository}"
  code "$HOME/$repo"
}

#
#
# git clone
# llag htms_web
llag() {
    local repo="${1:?Cách dùng: llag ten-repository}"
    cd ~ || return
    git clone "git@github.com:cskh-htms/${repo}.git"
}


#
#
# Chay git-push.sh cua repository hien tai, ke ca khi dang o thu muc con.
lla() {
    local repo_root
    repo_root="$(git rev-parse --show-toplevel 2>/dev/null)" || {
        printf '%s\n' 'Loi: Hay cd vao du an Git truoc khi chay lla.' >&2
        return 1
    }
    if [ ! -f "$repo_root/scripts/git-push.sh" ]; then
        printf 'Loi: Du an khong co %s/scripts/git-push.sh\n' "$repo_root" >&2
        return 1
    fi
    (cd -- "$repo_root" && bash "$repo_root/scripts/git-push.sh" "$@")
}

