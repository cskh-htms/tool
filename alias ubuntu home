  printf "%-32s %10s  %-12s  %-18s\n", "TEN IMAGE", "DUNG LUONG", "IMAGE ID", "TAG"
}
{
  size = ($1 >= 1000000000) \
    ? sprintf("%.2f GB", $1 / 1000000000) \
    : sprintf("%.1f MB", $1 / 1000000)

  id = $2
  sub(/^sha256:/, "", id)
  id = substr(id, 1, 12)

  n = split($3, refs, ",")
  for (i = 1; i <= n; i++) {
    ref = refs[i]
