1. Bảng audit_logs
------------------------------------------
CREATE TABLE audit_logs (
  id BIGSERIAL PRIMARY KEY,

  table_name TEXT NOT NULL,
  record_id TEXT NULL,
  action_type TEXT NOT NULL CHECK (action_type IN ('INSERT', 'UPDATE', 'DELETE')),

  action_code TEXT NULL,
  action_user_id TEXT NULL,
  action_agent TEXT NULL,
  action_business TEXT NULL,
  actor_type TEXT NULL,
  ip_address TEXT NULL,
  request_path TEXT NULL,

  restore_of_action_code TEXT NULL,
  restore_reason TEXT NULL,

  old_data JSONB NULL,
  new_data JSONB NULL,

  created_at TIMESTAMPTZ NOT NULL DEFAULT now()
);



CREATE INDEX idx_audit_logs_action_code
ON audit_logs (action_code);

CREATE INDEX idx_audit_logs_action_user_id
ON audit_logs (action_user_id);

CREATE INDEX idx_audit_logs_action_business
ON audit_logs (action_business);

CREATE INDEX idx_audit_logs_table_record
ON audit_logs (table_name, record_id);

CREATE INDEX idx_audit_logs_created_at
ON audit_logs (created_at);

CREATE INDEX idx_audit_logs_action_type
ON audit_logs (action_type);




2. Trigger Function Dùng Chung
---------------------------------------------------------------
CREATE OR REPLACE FUNCTION audit_log_changes()
RETURNS TRIGGER AS $$
DECLARE
  v_action_code TEXT;
  v_action_user_id TEXT;
  v_action_agent TEXT;
  v_action_business TEXT;
  v_actor_type TEXT;
  v_ip_address TEXT;
  v_request_path TEXT;
  v_restore_of_action_code TEXT;
  v_restore_reason TEXT;
  v_record_id TEXT;
BEGIN
  v_action_code := current_setting('audit.action_code', true);
  v_action_user_id := current_setting('audit.action_user_id', true);
  v_action_agent := current_setting('audit.action_agent', true);
  v_action_business := current_setting('audit.action_business', true);
  v_actor_type := current_setting('audit.actor_type', true);
  v_ip_address := current_setting('audit.ip_address', true);
  v_request_path := current_setting('audit.request_path', true);
  v_restore_of_action_code := current_setting('audit.restore_of_action_code', true);
  v_restore_reason := current_setting('audit.restore_reason', true);

  IF v_action_code IS NULL OR v_action_code = '' THEN
    RAISE EXCEPTION 'Missing audit.action_code';
  END IF;

  IF v_action_user_id IS NULL OR v_action_user_id = '' THEN
    RAISE EXCEPTION 'Missing audit.action_user_id';
  END IF;

  IF v_action_business IS NULL OR v_action_business = '' THEN
    RAISE EXCEPTION 'Missing audit.action_business';
  END IF;

  IF TG_OP = 'INSERT' THEN
    v_record_id := (to_jsonb(NEW)->>'id');

    INSERT INTO audit_logs (
      table_name,
      record_id,
      action_type,
      action_code,
      action_user_id,
      action_agent,
      action_business,
      actor_type,
      ip_address,
      request_path,
      restore_of_action_code,
      restore_reason,
      old_data,
      new_data
    )
    VALUES (
      TG_TABLE_NAME,
      v_record_id,
      'INSERT',
      v_action_code,
      v_action_user_id,
      v_action_agent,
      v_action_business,
      v_actor_type,
      v_ip_address,
      v_request_path,
      v_restore_of_action_code,
      v_restore_reason,
      NULL,
      to_jsonb(NEW)
    );

    RETURN NEW;
  END IF;

  IF TG_OP = 'UPDATE' THEN
    v_record_id := COALESCE(to_jsonb(NEW)->>'id', to_jsonb(OLD)->>'id');

    INSERT INTO audit_logs (
      table_name,
      record_id,
      action_type,
      action_code,
      action_user_id,
      action_agent,
      action_business,
      actor_type,
      ip_address,
      request_path,
      restore_of_action_code,
      restore_reason,
      old_data,
      new_data
    )
    VALUES (
      TG_TABLE_NAME,
      v_record_id,
      'UPDATE',
      v_action_code,
      v_action_user_id,
      v_action_agent,
      v_action_business,
      v_actor_type,
      v_ip_address,
      v_request_path,
      v_restore_of_action_code,
      v_restore_reason,
      to_jsonb(OLD),
      to_jsonb(NEW)
    );

    RETURN NEW;
  END IF;

  IF TG_OP = 'DELETE' THEN
    v_record_id := (to_jsonb(OLD)->>'id');

    INSERT INTO audit_logs (
      table_name,
      record_id,
      action_type,
      action_code,
      action_user_id,
      action_agent,
      action_business,
      actor_type,
      ip_address,
      request_path,
      restore_of_action_code,
      restore_reason,
      old_data,
      new_data
    )
    VALUES (
      TG_TABLE_NAME,
      v_record_id,
      'DELETE',
      v_action_code,
      v_action_user_id,
      v_action_agent,
      v_action_business,
      v_actor_type,
      v_ip_address,
      v_request_path,
      v_restore_of_action_code,
      v_restore_reason,
      to_jsonb(OLD),
      NULL
    );

    RETURN OLD;
  END IF;

  RETURN NULL;
END;
$$ LANGUAGE plpgsql;


3. Gắn Trigger Vào Bảng
--------------------------------------------------------------

CREATE TRIGGER trg_audit_orders
AFTER INSERT OR UPDATE OR DELETE ON orders
FOR EACH ROW
EXECUTE FUNCTION audit_log_changes();

CREATE TRIGGER trg_audit_order_items
AFTER INSERT OR UPDATE OR DELETE ON order_items
FOR EACH ROW
EXECUTE FUNCTION audit_log_changes();

